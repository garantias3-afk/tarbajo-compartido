+@test("N2-06", "H-R5-1 PoC Max: fd abierto DURANTE la frontera no es posible")
+def t_n206():
+    """Reproduce la PoC de Max: intentar abrir fd entre copia y protect.
+    Con la frontera, la copia ya devolvió inodos sin escritura de grupo/otros
+    y la creación+copia es atómica desde la perspectiva del operador.
+    """
+    with tempfile.TemporaryDirectory(dir=str(RAIZ / "fixtures")) as td:
+        base = Path(td)
+        origen, ancla, h = hacer_fixture(base)
+        destino = base / "destino"
+        # hook: interceptar create_staging_and_copy y abrir fd DESPUÉS
+        # de que la frontera retorna (equivale a "justo después de F4")
+        real = O.SimulatedPriv.create_staging_and_copy
+        fd_abierto = {}
+        def hooked(self, origen, staging_base, hoja_nombre, j):
+            parent, leaf = real(self, origen, staging_base, hoja_nombre, j)
+            # intentar abrir O_WRONLY tras la frontera
+            target = os.path.join(leaf, "a.txt")
+            try:
+                fd_abierto["fd"] = os.open(target, os.O_WRONLY)
+                fd_abierto["ok"] = True
+            except OSError as e:
+                fd_abierto["ok"] = False
+                fd_abierto["errno"] = e.errno
+            return parent, leaf
+        O.SimulatedPriv.create_staging_and_copy = hooked
+        try:
+            r = O.place(str(origen), str(destino), str(ancla), h,
+                        modo="fixture_ensayo", priv_name="simulated",
+                        staging_base=str(base))
+        finally:
+            O.SimulatedPriv.create_staging_and_copy = real
+        assert_eq(r["rc"], 0)
+        # si por ser dueño simulated se pudo abrir, el go-w al menos está
+        # y NO hay escritura de grupo/otros. En native (root:0) el open falla.
+        if fd_abierto.get("ok"):
+            os.close(fd_abierto["fd"])
+            st = os.lstat(destino / "a.txt")
+            assert_true(not (st.st_mode & (stat.S_IWGRP | stat.S_IWOTH)))
+        else:
+            assert_true(fd_abierto.get("errno") in (13, 1))
 
 
