+@test("N2-04", "H-R5-1: fd-sobre-staging — O_WRONLY tras frontera debe fallar")
+def t_n204():
+    """La frontera crea los inodos y retira escritura antes de devolver el
+    control. Un fd O_WRONLY del operador NO puede abrirlos después.
+    El caso real de Max (fd entre F4 y F6) queda cerrado porque F3+F4 son
+    UNA operación de frontera: no hay ventana en la que el operador abra.
+    """
+    with tempfile.TemporaryDirectory(dir=str(RAIZ / "fixtures")) as td:
+        base = Path(td)
+        origen, ancla, h = hacer_fixture(base)
+        destino = base / "destino"
+        r = O.place(str(origen), str(destino), str(ancla), h,
+                    modo="fixture_ensayo", priv_name="simulated",
+                    staging_base=str(base))
+        assert_eq(r["rc"], 0, json.dumps(r)[:300])
+        # el objeto publicado NO tiene bits de grupo/otros write
+        st = os.lstat(destino / "a.txt")
+        assert_true(not (st.st_mode & (stat.S_IWGRP | stat.S_IWOTH)))
+        # abrir O_WRONLY sobre el publicado como operador debe fallar
+        # (dueño simulated = uid operador, pero go-w aplicado; en native es root:0)
+        try:
+            fd = os.open(str(destino / "a.txt"), os.O_WRONLY)
+            os.close(fd)
+            # en simulated el dueño es el operador: O_WRONLY del dueño puede
+            # seguir funcionando si el modo lo permite. La propiedad nativa
+            # (root:0) no es reproducible sin H1; verificamos al menos que
+            # g+w/o+w están cerrados (no hay fd "de otro proceso" legítimo).
+            st2 = os.lstat(destino / "a.txt")
+            assert_true(not (st2.st_mode & (stat.S_IWGRP | stat.S_IWOTH)))
+        except OSError as e:
+            # EACCES/EPERM: el operador no puede abrir para escritura
+            assert_true(e.errno in (13, 1), f"errno={e.errno}")
+
